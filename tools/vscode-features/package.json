{
  "name": "helios-features",
  "displayName": "Helios Features",
  "description": "Move items of features-and-improvements.md, bug-reports.md and reminders.md between sections from the Markdown preview.",
  "publisher": "helios",
  "version": "0.1.3",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.70.0" },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:markdown", "onUri"],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": ["./preview.css"]
  }
}
