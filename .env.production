# Configurazione pubblica della build di produzione (GitHub Pages). NON mettere segreti qui:
# tutto ciò che inizia con VITE_ finisce nel JavaScript del sito.

# TURN predefinito: il Worker in cloudflare/turn-credentials (stampato da `npx wrangler deploy`).
# Restituisce credenziali temporanee del TURN di Cloudflare; il token resta nel Worker.
VITE_ICE_SERVERS_URL=https://ygo-turn-credentials.dupont9029.workers.dev

# Server di segnalazione predefinito (stanze online con codice di 6 caratteri): lo stesso Worker.
VITE_SIGNAL_URL=https://ygo-turn-credentials.dupont9029.workers.dev
