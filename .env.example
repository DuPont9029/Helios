# Copia in .env.local (ignorato da git) per provare in locale; su GitHub Pages usa i Secrets del repository.
# I valori finiscono nel JavaScript pubblicato: chiunque visiti il sito può leggerli.

# TURN con credenziali fisse (URL separati da spazi)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Oppure: URL che restituisce i server ICE con credenziali temporanee
# (JSON [{urls, username, credential}] o {iceServers: [...]}, es. l'API di Metered)
VITE_ICE_SERVERS_URL=

# Cartella dei campi 3D predefinita (index.json + Mat_xxx/near|far.glb|json) su un sito esterno con CORS.
# I campi non vanno mai messi nel repository; ognuno può comunque indicarne un'altra in Settings → Field.
VITE_FIELDS_URL=
